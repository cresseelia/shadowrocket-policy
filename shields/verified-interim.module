#!name=NOIR Verified Interim Shield
#!desc=Small on-device verified patch: three existing tracker rejects use native pre-matching; HTTPS/SVCB forwarding disabled. Full-list validation remains pending.

[General]
allow-dns-svcb = false

[Rule]
DOMAIN,metrics-picture.d.meituan.net,REJECT,pre-matching
DOMAIN,spider-tracker.xiaohongshu.com,REJECT,pre-matching
DOMAIN,catfront.dianping.com,REJECT,pre-matching
